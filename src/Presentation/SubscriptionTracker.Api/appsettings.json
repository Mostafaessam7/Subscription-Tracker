{
  "ConnectionStrings": {
    "SubscriptionTrackerDb": "Server=(localdb)\\mssqllocaldb;Database=SubscriptionTracker;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "SubscriptionTracker",
    "Audience": "SubscriptionTracker.Clients",
    "SigningKey": "REPLACE_WITH_A_SECRET_AT_LEAST_32_CHARACTERS_LONG",
    "AccessTokenLifetimeMinutes": 15
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@subscriptiontracker.app",
    "FromName": "Subscription Tracker",
    "FrontendBaseUrl": "https://localhost:4200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
