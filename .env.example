# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored - never commit real secrets.

MSSQL_SA_PASSWORD=Change_Me_123!
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Optional - leave blank to disable outbound email (logged as a warning, not an error)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@subscriptiontracker.app

# Base URL of the Angular frontend, used to build email verification/reset links
FRONTEND_BASE_URL=http://localhost:4200

# Optional - OTLP collector endpoint (e.g. http://localhost:4317) for traces/metrics. Leave blank to skip exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional - email of an already-registered user to auto-promote to system admin on the next startup.
# Only takes effect once; leave blank once the first admin is bootstrapped.
SYSTEM_ADMIN_BOOTSTRAP_EMAIL=
